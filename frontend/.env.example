# API base URL (no trailing slash). Change when deploying backend separately.
VITE_API_BASE_URL=http://localhost:7777

# App branding (optional overrides)
VITE_APP_NAME=PayrollPro

# Demo login when backend auth is unavailable (set to "true" for local UI demos)
VITE_USE_DEMO_AUTH=true
VITE_DEMO_EMAIL=admin@payrollpro.com
VITE_DEMO_PASSWORD=admin123
